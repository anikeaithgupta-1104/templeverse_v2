# ==========================================================
# TempleVerse — environment configuration
# Copy to .env and fill in. Every variable is OPTIONAL:
# the app falls back to built-in demo data + browser speech,
# so a demonstration never breaks.
# ==========================================================

# ---------- Supabase (content database) ----------
# Only the public anon key belongs here. Row Level Security
# restricts the anon role to reading published content.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# ---------- AI voice (Arya narration) ----------
# LEVEL 1 (default, no key): the browser SpeechSynthesis engine is
#   used and the UI honestly labels it "AI Voice Demo".
# LEVEL 2: set this to "true" to route narration through a
#   SERVER-SIDE endpoint that holds the provider credentials.
VITE_AI_VOICE_ENABLED=false
VITE_AI_VOICE_ENDPOINT=/api/tts

# ---------- Server-side only (NEVER prefixed with VITE_) ----------
# These must live on your server / edge function, not in the bundle.
# Pick whichever provider sits behind /api/tts:
# OPENAI_API_KEY=
# GOOGLE_TTS_API_KEY=
# AZURE_SPEECH_KEY=
# ELEVENLABS_API_KEY=
